{
  "manifest_version": 3,
  "name": "Sabbath Reminder",
  "version": "1.0.0",
  "description": "Reminds acts2.network Gmail users that Monday is e-sabbath before sending email, with the option to schedule for the next day.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content.js"],
      "css": ["src/modal.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": ["https://mail.google.com/*"]
}
